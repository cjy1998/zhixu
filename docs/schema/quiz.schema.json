{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathly.local/schema/quiz.schema.json",
  "title": "Quiz",
  "description": "为某节点生成的检验：恰好 3 题（单选/概念/编码各一题）。本 schema 是 AI 的完整输出（含正确答案）；Spring 侧向客户端下发前必须摘除 answerIndex/referenceAnswer 等答案字段。",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodeTitle", "questions"],
  "properties": {
    "nodeTitle": { "type": "string", "maxLength": 80 },
    "questions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "prompt", "options", "answerIndex", "explanation"],
            "properties": {
              "type": { "const": "choice" },
              "prompt": { "type": "string", "minLength": 10, "maxLength": 300 },
              "options": {
                "type": "array", "minItems": 4, "maxItems": 4,
                "items": { "type": "string", "minLength": 1, "maxLength": 120 }
              },
              "answerIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
              "explanation": { "type": "string", "minLength": 10, "maxLength": 400, "description": "正确选项的推断依据，判分后展示" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "prompt", "referenceAnswer", "keyPoints"],
            "properties": {
              "type": { "const": "concept" },
              "prompt": { "type": "string", "minLength": 10, "maxLength": 300 },
              "referenceAnswer": { "type": "string", "minLength": 20, "description": "参考答案文本" },
              "keyPoints": {
                "type": "array", "minItems": 2, "maxItems": 5,
                "items": { "type": "string", "minLength": 2, "maxLength": 60 },
                "description": "合格答案必须命中的关键点，作为 /ai/grade 的判分依据"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "prompt", "language", "referenceAnswer", "checks"],
            "properties": {
              "type": { "const": "code" },
              "prompt": { "type": "string", "minLength": 20, "maxLength": 500 },
              "language": { "enum": ["java", "typescript", "javascript", "python", "sql", "pseudo"] },
              "starterCode": { "type": ["string", "null"], "description": "提供给学习者的起始代码骨架，可为 null" },
              "referenceAnswer": { "type": "string", "minLength": 20 },
              "checks": {
                "type": "array", "minItems": 2, "maxItems": 6,
                "items": { "type": "string", "minLength": 2, "maxLength": 80 },
                "description": "合格代码必须满足的要点（供判分与反馈引用）"
              }
            }
          }
        ]
      }
    }
  }
}
