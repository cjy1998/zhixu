{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathly.local/schema/grade.schema.json",
  "title": "Grade",
  "description": "/ai/grade 的输出：对概念题或编码题主观作答的判分。暖色反馈而非惩罚式警示（对照原型 13 屏：薄弱点+可执行建议，避免冷冰冰的分数）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["passed", "score", "feedback", "suggestions"],
  "properties": {
    "passed": { "type": "boolean" },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "feedback": { "type": "string", "minLength": 10, "maxLength": 400, "description": "对学习者答案的一两句总评（先肯定再指正）" },
    "missingPoints": {
      "type": "array",
      "items": { "type": "string", "maxLength": 120 },
      "description": "应覆盖但没覆盖的关键点，可为空"
    },
    "wrongPoints": {
      "type": "array",
      "items": { "type": "string", "maxLength": 160 },
      "description": "答案中的错误理解，可为空"
    },
    "suggestions": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": { "type": "string", "minLength": 6, "maxLength": 160 },
      "description": "可执行的下一步复习建议（做什么、看什么、写什么）"
    },
    "strengths": {
      "type": "array",
      "items": { "type": "string", "maxLength": 120 },
      "description": "答对/接近的关键点，可为空"
    }
  }
}
